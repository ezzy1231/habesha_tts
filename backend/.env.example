# Backend environment example for local dev (localhost frontend + backend)

# Frontend origin used by CORS allowlist
FRONTEND_URL=http://localhost:5173

# OTP and JWT
ENABLE_STREAMER_OTP=true
JWT_SECRET=replace-with-a-strong-secret
JWT_EXPIRES_IN=7d
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_LOCK_MINUTES=15

# Cross-site cookie settings for localhost dev
# When frontend and backend are on different origins during local dev,
# use SameSite=None and do NOT set Secure so the browser stores the cookie on http.
CROSS_SITE_COOKIES=true
COOKIE_SAMESITE=None
COOKIE_SECURE=false

# Database (Neon or other Postgres)
# Example: postgres://user:password@host:port/dbname?sslmode=require
DATABASE_URL=postgres://user:password@host:5432/dbname
